{
    "name": "ankjyotish/core-platform",
    "type": "project",
    "description": "AnkJyotish AI — Enterprise Astrological & Numerological Intelligence Platform",
    "keywords": ["astrology", "numerology", "ai", "ecommerce", "affiliate", "laravel"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
